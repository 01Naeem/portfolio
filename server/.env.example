NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# Auth (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
COOKIE_NAME=portfolio_token

# Allowed browser origins, comma separated. With the Vercel /api rewrite (same-origin)
# this is only needed for local dev and direct API calls.
CLIENT_ORIGINS=http://localhost:5173

# Public URL of the frontend, used in sitemap.xml, robots.txt and link-preview pages.
# (Site Settings > Site URL, if set, takes precedence.)
SITE_URL=http://localhost:5173

# Number of reverse proxies in front of Express. Rate limits are keyed on the client IP, so this must be right:
#   0 = running locally, no proxy
#   1 = Render/Railway directly
#   2 = Vercel rewrite -> Render (this project's production setup); verify with GET /api/health/ip once deployed
TRUST_PROXY=0

# ---- Cloudinary (image + resume uploads). Dashboard -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Email notifications for contact form (any SMTP provider; Gmail needs an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portfolio <you@example.com>"
# Where alerts go. Falls back to Site Settings > notification email, then Profile email.
ADMIN_NOTIFY_EMAIL=

# ---- Optional
# Enables the GitHub contribution graph (GraphQL needs a token). Fine-grained token, read-only public data.
GITHUB_TOKEN=
# Salt for hashing visitor IPs in stored messages (defaults to JWT_SECRET)
IP_HASH_SALT=
